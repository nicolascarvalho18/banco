# ==============================================================================
# Banco SAP - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com as configurações do seu ambiente
# ==============================================================================

# Porta do Servidor
PORT=8080

# Perfil do Spring (dev para H2 em memória, prod para PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Banco de Dados PostgreSQL (Perfil de Produção)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bancosapdb
SPRING_DATASOURCE_USERNAME=bancosap
SPRING_DATASOURCE_PASSWORD=sua_senha_segura_aqui

# Segredo JWT (Chave Base64 de 256 bits para assinatura HMAC-SHA256)
JWT_SECRET=bW9kZXJuLWJhbmNvLXNhcC1zZWN1cmUtand0LXNlY3JldC1rZXktZXhhbXBsZS0yNTYtYml0cw==
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Origins Permitidos (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
